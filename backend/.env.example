# Copy this file to .env and change the values.
DATABASE_URL=sqlite:///./abdm_connect.db
# Use a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
FHIR_BASE_URL=http://localhost:8000/api/v1/fhir
# ABDM connection. The defaults talk to the local mock server (mock_abdm/, port 9000), not real ABDM.
# Put real sandbox credentials here only, never in code or git.
ABDM_BASE_URL=http://localhost:9000
ABDM_CLIENT_ID=SBX_MOCK_001
ABDM_CLIENT_SECRET=mock-secret-change-me
